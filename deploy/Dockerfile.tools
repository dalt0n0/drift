# syntax=docker/dockerfile:1
# ──────────────────────────────────────────────────────────────────────
# Drift Tools Container — Kali-based image with all recon/scanning tools
# ──────────────────────────────────────────────────────────────────────
FROM kalilinux/kali-rolling:latest AS tools

LABEL maintainer="drift" \
      description="Drift recon, scanning, web, and network tools container"

ENV DEBIAN_FRONTEND=noninteractive

# ── Lock apt to kali.download only.
#    The base image ships sources.list.d/ entries with mirror lists that
#    redirect to mirror.us.cdn-perfprod.com (currently dead).  Wipe them all,
#    then disable HTTP redirects so apt never follows a 302 to a CDN node. ──
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list \
            /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://kali.download/kali kali-rolling main contrib non-free non-free-firmware\n' \
        > /etc/apt/sources.list && \
    printf 'Acquire::Retries "10";\n\
Acquire::http::Timeout "60";\n\
Acquire::https::Timeout "60";\n\
Acquire::http::AllowRedirect "false";\n' \
        > /etc/apt/apt.conf.d/99drift-mirror

# ── System packages & base tools ─────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    unzip \
    jq \
    dnsutils \
    python3 \
    python3-pip \
    python3-venv \
    golang-go \
    nmap \
    masscan \
    # Network tools
    net-tools \
    iputils-ping \
    whois \
    # Web tools (apt)
    nikto \
    wapiti \
    # TLS tools
    testssl.sh \
    openssl \
    # Network enumeration
    smbclient \
    smbmap \
    ldap-utils \
    onesixtyone \
    enum4linux \
    python3-impacket \
    # Misc
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# ── Go environment ───────────────────────────────────────────────────
ENV GOPATH=/root/go
ENV PATH="${GOPATH}/bin:/usr/local/go/bin:${PATH}"

# ── Go-based tools: recon ────────────────────────────────────────────
RUN go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest && \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest && \
    go install github.com/tomnomnom/assetfinder@latest && \
    go install github.com/tomnomnom/waybackurls@latest && \
    go install github.com/lc/gau/v2/cmd/gau@latest && \
    go clean -cache -modcache

# ── Go-based tools: web ──────────────────────────────────────────────
RUN go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && \
    go install github.com/projectdiscovery/katana/cmd/katana@latest && \
    go install github.com/ffuf/ffuf/v2@latest && \
    go install github.com/OJ/gobuster/v3@latest && \
    go install github.com/epi052/feroxbuster@latest 2>/dev/null || \
    # feroxbuster is Rust-based; install via cargo or prebuilt binary
    curl -sL https://raw.githubusercontent.com/epi052/feroxbuster/main/install-nix.sh | bash 2>/dev/null || true && \
    go clean -cache -modcache

# ── Update Nuclei templates ───────────────────────────────────────────
RUN nuclei -update-templates 2>/dev/null || true

# ── OWASP Amass ──────────────────────────────────────────────────────
RUN go install github.com/owasp-amass/amass/v4/...@master && \
    go clean -cache -modcache

# ── RustScan ─────────────────────────────────────────────────────────
RUN wget -q https://github.com/RustScan/RustScan/releases/download/2.3.0/rustscan_2.3.0_amd64.deb -O /tmp/rustscan.deb && \
    dpkg -i /tmp/rustscan.deb || apt-get install -f -y && \
    rm /tmp/rustscan.deb

# ── enum4linux-ng ─────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/cddmp/enum4linux-ng /opt/enum4linux-ng && \
    pip3 install --no-cache-dir --break-system-packages -r /opt/enum4linux-ng/requirements.txt && \
    ln -sf /opt/enum4linux-ng/enum4linux-ng.py /usr/local/bin/enum4linux-ng

# ── NetExec (nxc) ─────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages netexec 2>/dev/null || \
    pip3 install --no-cache-dir --break-system-packages crackmapexec 2>/dev/null || true

# ── OWASP ZAP ────────────────────────────────────────────────────────
RUN wget -q https://github.com/zaproxy/zaproxy/releases/download/v2.14.0/ZAP_2.14.0_Linux.tar.gz \
        -O /tmp/zap.tar.gz && \
    tar xzf /tmp/zap.tar.gz -C /opt/ && \
    mv /opt/ZAP_2.14.0 /opt/zap && \
    ln -sf /opt/zap/zap.sh /usr/local/bin/zap.sh && \
    ln -sf /opt/zap/zap-baseline.py /usr/local/bin/zap-baseline.py && \
    ln -sf /opt/zap/zap-full-scan.py /usr/local/bin/zap-full-scan.py && \
    rm /tmp/zap.tar.gz

# ── Python-based tools ───────────────────────────────────────────────
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    theHarvester \
    sherlock-project \
    sslyze \
    playwright

# ── Playwright browsers ───────────────────────────────────────────────
RUN playwright install chromium && \
    playwright install-deps chromium 2>/dev/null || true

# ── sslyze ────────────────────────────────────────────────────────────
# sslyze installed via pip above; verify it works
RUN sslyze --version 2>/dev/null || true

# ── Copy Go binaries to standard path ─────────────────────────────────
RUN cp -a ${GOPATH}/bin/* /usr/local/bin/ 2>/dev/null || true

# ── Non-root user ─────────────────────────────────────────────────────
RUN groupadd -r -g 1000 drift && \
    useradd -r -u 1000 -g drift -m -s /bin/bash drift

# ── Working directory ─────────────────────────────────────────────────
WORKDIR /work
RUN chown drift:drift /work

USER drift

# ── Healthcheck ───────────────────────────────────────────────────────
HEALTHCHECK --interval=60s --timeout=15s --retries=3 \
    CMD subfinder -version > /dev/null 2>&1 && \
        nuclei -version > /dev/null 2>&1 && \
        nmap --version > /dev/null 2>&1

# Default: idle (tools are invoked by the API service via docker exec or RPC)
CMD ["sleep", "infinity"]
