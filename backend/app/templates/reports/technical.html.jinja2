{% extends "reports/base.html.jinja2" %}
{% block body %}

<!-- Cover -->
<div class="cover">
  <div class="cover-logo">Drift</div>
  <div class="cover-title">{{ engagement.title }}</div>
  <div class="cover-subtitle">Technical Penetration Test Report</div>
  <div class="cover-meta">
    <strong>Client:</strong> {{ engagement.client_name }}<br>
    <strong>Classification:</strong> CONFIDENTIAL — RESTRICTED<br>
    <strong>Report Date:</strong> {{ generated_at }}<br>
    {% if engagement.start_date %}<strong>Assessment Period:</strong> {{ engagement.start_date }} — {{ engagement.end_date or "Ongoing" }}<br>{% endif %}
    <strong>Total Findings:</strong> {{ total_findings }}
  </div>
</div>

<!-- Disclaimer -->
<p style="font-size:8.5pt; color:#64748b; border:1px solid #e2e8f0; padding:0.75rem; border-radius:4px; margin-bottom:1rem;">
  RESTRICTED. This technical report contains detailed exploit information and must not be distributed beyond authorized personnel. All testing was conducted under written authorization.
</p>

<!-- Statistics -->
<h1>Finding Statistics</h1>
<div class="stat-grid">
  <div class="stat-box stat-critical"><div class="count">{{ by_severity.critical | default(0) }}</div><div class="label">Critical</div></div>
  <div class="stat-box stat-high"><div class="count">{{ by_severity.high | default(0) }}</div><div class="label">High</div></div>
  <div class="stat-box stat-medium"><div class="count">{{ by_severity.medium | default(0) }}</div><div class="label">Medium</div></div>
  <div class="stat-box stat-low"><div class="count">{{ by_severity.low | default(0) }}</div><div class="label">Low</div></div>
  <div class="stat-box stat-info"><div class="count">{{ by_severity.info | default(0) }}</div><div class="label">Info</div></div>
</div>

<!-- Finding Summary Table -->
<h1>Finding Summary</h1>
<table>
  <thead>
    <tr><th>#</th><th>Title</th><th>Severity</th><th>CVSS</th><th>Target</th><th>Tool</th><th>Status</th></tr>
  </thead>
  <tbody>
    {% for f in findings %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ f.title }}</td>
      <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
      <td>{{ f.cvss_score if f.cvss_score else '—' }}</td>
      <td style="word-break:break-all;">{{ f.affected_target }}</td>
      <td>{{ f.discovered_by }}</td>
      <td>{{ f.status | replace('_', ' ') | title }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<!-- Detailed Findings -->
<h1>Detailed Findings</h1>

{% for f in findings %}
<div class="finding">
  <div class="finding-header">
    <div>
      <div class="finding-title">{{ loop.index }}. {{ f.title }}</div>
      <div class="finding-meta">
        <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
        {% if f.cvss_score %}&nbsp; CVSS {{ f.cvss_score }}{% endif %}
        {% if f.epss_score %}&nbsp; EPSS {{ "%.1f"|format(f.epss_score * 100) }}%{% endif %}
        {% if f.cisa_kev %}&nbsp; <span class="badge badge-critical">CISA KEV</span>{% endif %}
      </div>
    </div>
    <div style="text-align:right; font-size:8.5pt; color:#64748b;">
      {{ f.discovered_by }}<br>{{ f.status | replace('_', ' ') | title }}
    </div>
  </div>

  <div class="finding-body">
    {% if f.affected_target %}
    <p><strong>Affected Target:</strong> <code>{{ f.affected_target }}</code></p>
    {% endif %}

    {% if f.cve_ids %}
    <p><strong>CVEs:</strong> {{ f.cve_ids | join(', ') }}</p>
    {% endif %}

    {% if f.attack_technique_ids %}
    <p><strong>ATT&amp;CK:</strong> {{ f.attack_technique_ids | join(', ') }}</p>
    {% endif %}

    <h3>Description</h3>
    <p>{{ f.description or 'No description provided.' }}</p>

    {% if f.cvss_vector %}
    <h3>CVSS Vector</h3>
    <p><code>{{ f.cvss_vector }}</code></p>
    {% endif %}

    {% set evidence = f.evidence or {} %}
    {% if evidence.get('request') %}
    <h3>HTTP Request</h3>
    <pre>{{ evidence['request'][:1500] }}</pre>
    {% endif %}

    {% if evidence.get('response') %}
    <h3>HTTP Response (excerpt)</h3>
    <pre>{{ evidence['response'][:1000] }}</pre>
    {% endif %}

    {% if evidence.get('output') %}
    <h3>Tool Output</h3>
    <pre>{{ evidence['output'][:2000] }}</pre>
    {% endif %}

    {% if f.notes %}
    <h3>Analyst Notes</h3>
    <p>{{ f.notes }}</p>
    {% endif %}

    <h3>Remediation Guidance</h3>
    <p>{{ _remediation(f) }}</p>
  </div>
</div>
{% else %}
<p>No findings recorded for this engagement.</p>
{% endfor %}

<!-- Scope -->
<h1>Scope</h1>
{% if scope_items %}
<table>
  <thead><tr><th>Type</th><th>Target</th><th>Excluded</th><th>Notes</th></tr></thead>
  <tbody>
    {% for item in scope_items %}
    <tr>
      <td>{{ item.type }}</td>
      <td>{{ item.value }}</td>
      <td>{{ 'Yes' if item.is_excluded else 'No' }}</td>
      <td>{{ item.notes or '' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<!-- Footer -->
<div style="margin-top:2rem; padding-top:1rem; border-top:1px solid #e2e8f0; font-size:8.5pt; color:#64748b;">
  Generated by Drift {{ version }} on {{ generated_at }}.
</div>

{% endblock %}
