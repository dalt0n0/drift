{% extends "reports/base.html.jinja2" %}
{% block body %}

<!-- Cover -->
<div class="cover">
  <div class="cover-logo">Drift</div>
  <div class="cover-title">{{ engagement.title }}</div>
  <div class="cover-subtitle">Executive Summary — Penetration Test Report</div>
  <div class="cover-meta">
    <strong>Client:</strong> {{ engagement.client_name }}<br>
    <strong>Classification:</strong> CONFIDENTIAL<br>
    <strong>Report Date:</strong> {{ generated_at }}<br>
    {% if engagement.start_date %}<strong>Assessment Period:</strong> {{ engagement.start_date }} — {{ engagement.end_date or "Ongoing" }}<br>{% endif %}
    <strong>Report Type:</strong> Executive Summary (Client-Facing)
  </div>
</div>

<!-- Disclaimer -->
<p style="font-size:8.5pt; color:#64748b; border:1px solid #e2e8f0; padding:0.75rem; border-radius:4px; margin-bottom:1rem;">
  This report is CONFIDENTIAL and intended solely for {{ engagement.client_name }}. It contains sensitive security information and must not be distributed without authorization. All testing was conducted under written authorization.
</p>

<!-- Executive Summary -->
<h1>Executive Summary</h1>
<p>
  Drift conducted an authorized penetration test of {{ engagement.client_name }}'s environment.
  The assessment identified <strong>{{ total_findings }}</strong> finding{{ 's' if total_findings != 1 else '' }}
  across the tested scope.
</p>

{% if total_findings > 0 %}
<div class="stat-grid">
  <div class="stat-box stat-critical"><div class="count">{{ by_severity.critical | default(0) }}</div><div class="label">Critical</div></div>
  <div class="stat-box stat-high"><div class="count">{{ by_severity.high | default(0) }}</div><div class="label">High</div></div>
  <div class="stat-box stat-medium"><div class="count">{{ by_severity.medium | default(0) }}</div><div class="label">Medium</div></div>
  <div class="stat-box stat-low"><div class="count">{{ by_severity.low | default(0) }}</div><div class="label">Low</div></div>
  <div class="stat-box stat-info"><div class="count">{{ by_severity.info | default(0) }}</div><div class="label">Info</div></div>
</div>
{% endif %}

<!-- Risk Summary -->
<h1>Risk Summary</h1>
{% if critical_and_high %}
<p>The following <strong>{{ critical_and_high | length }}</strong> critical and high severity finding{{ 's' if critical_and_high | length != 1 else '' }} require immediate remediation:</p>
<table>
  <thead>
    <tr><th>#</th><th>Finding</th><th>Severity</th><th>Affected Target</th></tr>
  </thead>
  <tbody>
    {% for f in critical_and_high %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ f.title }}</td>
      <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
      <td>{{ f.affected_target }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>No critical or high severity findings were identified.</p>
{% endif %}

<!-- Recommendations -->
<h1>Recommendations</h1>
<p>We recommend prioritizing remediation of findings in the following order:</p>
<ol style="margin-left:1.5rem;">
  <li style="margin-bottom:0.4rem;"><strong>Immediate (0–7 days):</strong> Address all critical and high severity findings. These represent direct risk to business operations and sensitive data.</li>
  <li style="margin-bottom:0.4rem;"><strong>Short-term (7–30 days):</strong> Remediate medium severity findings. While not immediately exploitable in isolation, these can be chained with other vulnerabilities.</li>
  <li style="margin-bottom:0.4rem;"><strong>Ongoing:</strong> Review and address low and informational findings as part of routine security hardening.</li>
</ol>

<!-- Scope -->
<h1>Scope</h1>
{% if scope_items %}
<table>
  <thead><tr><th>Type</th><th>Target</th><th>Notes</th></tr></thead>
  <tbody>
    {% for item in scope_items %}
    {% if not item.is_excluded %}
    <tr>
      <td>{{ item.type }}</td>
      <td>{{ item.value }}</td>
      <td>{{ item.notes or '' }}</td>
    </tr>
    {% endif %}
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>Scope details are available in the technical report.</p>
{% endif %}

<!-- Footer info -->
<div style="margin-top:2rem; padding-top:1rem; border-top:1px solid #e2e8f0; font-size:8.5pt; color:#64748b;">
  Generated by Drift {{ version }} on {{ generated_at }}.
  This is an executive summary. The full technical report contains detailed findings, evidence, and remediation guidance.
</div>

{% endblock %}
