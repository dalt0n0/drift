# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://drift:CHANGE_ME@localhost:5432/drift

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_64_BYTE_HEX_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Vault encryption key ──────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=CHANGE_ME_FERNET_KEY

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://your-domain.com
SECRET_KEY=CHANGE_ME_32_BYTE_HEX_SECRET

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/drift/uploads
MAX_UPLOAD_SIZE_MB=50

# ── SMTP (notifications) ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=drift@your-domain.com
SMTP_TLS=true

# ── Slack (notifications) ─────────────────────────────────────────────────────
# Set via integrations UI — stored encrypted in DB

# ── Instance ──────────────────────────────────────────────────────────────────
DRIFT_HOST=https://your-domain.com
INSTANCE_NAME=drift.local
